# Dashboard access (required before deploying — protects /dashboard)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Chatbot brain (optional — without it, the widget uses simple templated replies)
ANTHROPIC_API_KEY=

# Payments — generates a Stripe Checkout link when a prospect wants to buy
STRIPE_SECRET_KEY=
SITE_URL=http://localhost:3000

# Social scheduling via Metricool (Facebook/Instagram/LinkedIn)
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# Escalation notifications — human needed, business idea to approve, payment to confirm
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
